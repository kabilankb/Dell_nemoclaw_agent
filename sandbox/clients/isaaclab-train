#!/usr/bin/env python3
"""Client for the NemoClaw Training Server. Runs inside the sandbox."""

import json
import sys
import urllib.request

HOST = "host.openshell.internal"
PORT = 5561
BASE = f"http://{HOST}:{PORT}"


def request(method, path, body=None):
    url = f"{BASE}{path}"
    data = json.dumps(body).encode("utf-8") if body else None
    headers = {"Content-Type": "application/json"} if data else {}
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        result = json.loads(e.read().decode("utf-8"))
        print(f"Error ({e.code}): {result.get('error', 'unknown')}")
        sys.exit(1)
    except Exception as e:
        print(f"Connection failed: {e}")
        print("Make sure the training server is running on the host:")
        print("  python scripts/tools/training_server.py")
        sys.exit(1)


def cmd_envs(args):
    result = request("GET", "/envs")
    envs = result["environments"]

    category_filter = None
    for a in args:
        if a in ("humanoid", "quadruped", "wheeled", "direct", "other"):
            category_filter = a

    if category_filter:
        envs = [e for e in envs if e["category"] == category_filter]

    current_cat = None
    for e in envs:
        if e["category"] != current_cat:
            current_cat = e["category"]
            print(f"\n  {current_cat.upper()}")
        terrain_tag = "flat" if e["terrain"] == "flat" else "rough"
        print(f"    [{terrain_tag:5s}] {e['id']}")
        print(f"           Robot: {e['robot']}")

    print(f"\n  Total: {len(envs)} environments")


def cmd_start(args):
    if not args:
        print("Usage: isaaclab-train start <TASK_ID> [--num_envs N] [--backend cusrl|rsl_rl] [--max_iterations N] [--seed N]")
        sys.exit(1)

    task = args[0]
    body = {"task": task}

    i = 1
    while i < len(args):
        if args[i] == "--num_envs" and i + 1 < len(args):
            body["num_envs"] = int(args[i + 1]); i += 2
        elif args[i] == "--backend" and i + 1 < len(args):
            body["backend"] = args[i + 1]; i += 2
        elif args[i] == "--max_iterations" and i + 1 < len(args):
            body["max_iterations"] = int(args[i + 1]); i += 2
        elif args[i] == "--seed" and i + 1 < len(args):
            body["seed"] = int(args[i + 1]); i += 2
        else:
            print(f"Unknown argument: {args[i]}"); sys.exit(1)

    result = request("POST", "/train", body)
    print(f"Training started!")
    print(f"  Task:     {result['task']}")
    print(f"  Backend:  {result['backend']}")
    print(f"  Num envs: {result['num_envs']}")
    print(f"  PID:      {result['pid']}")


def cmd_status(_args):
    result = request("GET", "/status")
    if result["running"]:
        print(f"Training RUNNING")
        print(f"  Task:     {result['task']}")
        print(f"  Backend:  {result['backend']}")
        print(f"  Num envs: {result['num_envs']}")
        print(f"  PID:      {result['pid']}")
        print(f"  Elapsed:  {result.get('elapsed_human', 'unknown')}")
    elif result.get("task"):
        print(f"Training COMPLETED")
        print(f"  Task:     {result['task']}")
        print(f"  Backend:  {result['backend']}")
    else:
        print("No training running or completed.")


def cmd_stop(_args):
    result = request("POST", "/stop")
    if result.get("status") == "stopped":
        print(f"Training stopped (task: {result['task']}, pid: {result['pid']})")
    else:
        print(result.get("status", "done"))


def cmd_logs(args):
    n = 30
    for i, a in enumerate(args):
        if a == "--lines" and i + 1 < len(args):
            n = int(args[i + 1])
    result = request("GET", f"/logs?lines={n}")
    lines = result.get("lines", "")
    if lines:
        print(lines)
    else:
        print("No log output yet.")


def main():
    commands = {
        "envs": cmd_envs,
        "start": cmd_start,
        "status": cmd_status,
        "stop": cmd_stop,
        "logs": cmd_logs,
    }

    if len(sys.argv) < 2 or sys.argv[1] not in commands:
        print("Usage: isaaclab-train <command> [args...]")
        print()
        print("Commands:")
        print("  envs   [category]                    List available environments")
        print("  start  <TASK_ID> [--num_envs N]      Start training")
        print("         [--backend cusrl|rsl_rl]")
        print("         [--max_iterations N] [--seed N]")
        print("  status                               Check training status")
        print("  stop                                 Stop current training")
        print("  logs   [--lines N]                   Tail training logs")
        sys.exit(1)

    cmd = sys.argv[1]
    commands[cmd](sys.argv[2:])


if __name__ == "__main__":
    main()
