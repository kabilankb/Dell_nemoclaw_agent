{
  "_comment": "OpenClaw model config for isaac-claw. OpenClaw runs OPEN local models (Gemma, etc.) via Ollama, unsandboxed on the host. Merge this 'models'/'agents' block into ~/.openclaw/openclaw.json, or keep it here as the source of truth and copy on setup. Pull the model first:  ollama pull gemma4:12b",
  "models": {
    "providers": {
      "ollama": {
        "baseUrl": "http://localhost:11434/v1",
        "apiKey": "ollama",
        "api": "openai-completions",
        "models": [
          {"id": "gemma4:12b", "name": "Gemma 4 12B (local)", "contextWindow": 65536, "maxTokens": 8192},
          {"id": "gemma4:31b", "name": "Gemma 4 31B (local)", "contextWindow": 65536, "maxTokens": 8192},
          {"id": "nemotron-3-super", "name": "Nemotron 3 Super (local)", "contextWindow": 131072, "maxTokens": 8192}
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "ollama/gemma4:12b",
        "fallbacks": ["ollama/gemma4:31b", "ollama/nemotron-3-super"]
      }
    }
  }
}
