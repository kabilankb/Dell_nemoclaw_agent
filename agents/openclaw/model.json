{
  "_comment": "OpenClaw model config for isaac-claw. OpenClaw runs OPEN local models (Gemma, etc.) via Ollama, unsandboxed on the host. Merge this 'models'/'agents' block into ~/.openclaw/openclaw.json, or keep it here as the source of truth and copy on setup. Pull the model first:  ollama pull gemma4:12b Hackathon: primary model is Nemotron 3 Super on Nebius Token Factory (export NEBIUS_API_KEY).",
  "models": {
    "providers": {
      "ollama": {
        "baseUrl": "http://localhost:11434/v1",
        "apiKey": "ollama",
        "api": "openai-completions",
        "models": [
          {
            "id": "gemma4:12b",
            "name": "Gemma 4 12B (local)",
            "contextWindow": 65536,
            "maxTokens": 8192
          },
          {
            "id": "gemma4:31b",
            "name": "Gemma 4 31B (local)",
            "contextWindow": 65536,
            "maxTokens": 8192
          },
          {
            "id": "nemotron-3-super",
            "name": "Nemotron 3 Super (local)",
            "contextWindow": 131072,
            "maxTokens": 8192
          }
        ]
      },
      "nebius": {
        "baseUrl": "https://api.tokenfactory.nebius.com/v1",
        "apiKey": "${NEBIUS_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "nvidia/nemotron-3-super-120b-a12b",
            "name": "Nemotron 3 Super (Nebius)",
            "contextWindow": 262144,
            "maxTokens": 8192
          },
          {
            "id": "nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B",
            "name": "Nemotron 3 Nano (Nebius)",
            "contextWindow": 262144,
            "maxTokens": 8192
          },
          {
            "id": "nvidia/Nemotron-3-Ultra-550b-a55b",
            "name": "Nemotron 3 Ultra (Nebius)",
            "contextWindow": 262144,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "nebius/nvidia/nemotron-3-super-120b-a12b",
        "fallbacks": [
          "nebius/nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B",
          "ollama/gemma4:12b"
        ]
      }
    }
  }
}