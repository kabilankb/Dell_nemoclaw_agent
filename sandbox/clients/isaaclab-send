#!/usr/bin/env python3
"""Send a single JSON command to LeIsaac OpenClawDevice via HTTP."""

import json
import sys
import urllib.request

HOST = "host.openshell.internal"
HTTP_PORT = 5560


def main():
    if len(sys.argv) < 2:
        print("Usage: isaaclab-send '<json-command>'")
        print('Example: isaaclab-send \'{"action": "forward", "params": {"distance": 0.3}}\'')
        sys.exit(1)

    try:
        cmd = json.loads(sys.argv[1])
    except json.JSONDecodeError as e:
        print(f"Invalid JSON: {e}")
        sys.exit(1)

    url = f"http://{HOST}:{HTTP_PORT}/command"
    try:
        data = json.dumps(cmd).encode("utf-8")
        req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=5) as resp:
            result = json.loads(resp.read().decode("utf-8"))
            print(f"Sent: {cmd['action']} {cmd.get('params', {})}")
            if result.get("status") == "error":
                print(f"Error: {result.get('message')}")
    except Exception as e:
        print(f"Failed to send command: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
