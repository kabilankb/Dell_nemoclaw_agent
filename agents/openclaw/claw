#!/usr/bin/env python3
"""claw — the single deterministic entrypoint for isaac-claw.

Collapses the whole control flow into ONE command so a small local model
(Gemma/Nemotron) only emits a single tool call. Also usable by hand.

    claw up                                  ensure the control server is running
    claw open --template warehouse_g1        launch a named template (env + robots)
    claw open --env warehouse --robot unitree_g1 [--anchor pick_station] [--gui]
        --gui  open a VISIBLE Isaac Sim window (needs a display); default headless
    claw open --scene warehouse.usd --robot unitree_g1 [--x 6 --y 0 --z 0.74]
    claw train --task <id> [--backend rsl_rl]
    claw close                               stop the sim/training, free the GPU
    claw templates | scenes | robots | envs | status

TEMPLATES decouple robot from environment:
  * robot height/drive come from the asset catalog (per-robot),
  * spawn position comes from the environment's named anchors,
so the SAME robot drops correctly into ANY environment with no pose math.
`claw open` does: ensure server -> persistent sim (bridge :8226) -> wait READY ->
spawn every robot in the resolved spec. Idempotent; safe to re-run.
"""
import json
import os
import subprocess
import sys
import time
import socket
import urllib.error
import urllib.request

import yaml  # available in both system python3 and env_isaaclab

BASE = f"http://localhost:{os.environ.get('ISAAC_CONTROL_PORT', '5561')}"
HERE = os.path.dirname(os.path.abspath(__file__))
CLAW_DIR = os.environ.get("ISAAC_CLAW_DIR", os.path.dirname(os.path.dirname(HERE)))
TPL_DIR = os.path.join(CLAW_DIR, "isaac_sim", "templates")
CATALOG = os.path.join(CLAW_DIR, "agents", "core", "assets", "catalog.yaml")


# --------------------------------------------------------------------------- #
# HTTP helpers
# --------------------------------------------------------------------------- #
def _req(method, path, body=None, timeout=10):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(BASE + path, data=data, method=method,
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, json.loads(r.read().decode() or "{}")
    except urllib.error.HTTPError as e:                 # 4xx/5xx -> report, don't crash
        try:
            return e.code, json.loads(e.read().decode() or "{}")
        except Exception:
            return e.code, {"error": str(e)}


def server_up():
    try:
        _req("GET", "/envs", timeout=3); return True
    except Exception:
        return False


def ensure_server():
    if server_up():
        return True
    print("[claw] control server down — starting it ...")
    subprocess.run(["bash", os.path.join(HERE, "clawup.sh")], check=False)
    for _ in range(30):
        if server_up():
            print("[claw] control server up."); return True
        time.sleep(1)
    print("[claw] ERROR: control server did not come up", file=sys.stderr)
    return False


# --------------------------------------------------------------------------- #
# Template resolution  (robot defaults from catalog × environment anchors)
# --------------------------------------------------------------------------- #
def _yaml(path):
    with open(path) as f:
        return yaml.safe_load(f) or {}


def robot_defaults(robot):
    """z/drive for a robot, straight from the asset catalog (the robot template)."""
    try:
        cat = _yaml(CATALOG)
        for cat_group in (cat.get("categories") or {}).values():
            if isinstance(cat_group, dict) and robot in cat_group:
                e = cat_group[robot] or {}
                return {"z": float(e.get("start_z", 0.0)), "drive": e.get("drive")}
    except Exception:
        pass
    return {"z": 0.0, "drive": None}


def env_template(name):
    envs = _yaml(os.path.join(TPL_DIR, "environments.yaml"))
    return envs.get(name)


def _place(robot, env, anchor, override):
    """Resolve one robot's pose: anchor x/y from env, z from catalog, overridable."""
    anchors = (env or {}).get("anchors") or {}
    a = anchors.get(anchor or (env or {}).get("default_anchor"), {})
    d = robot_defaults(robot)
    zv = override.get("z")
    z = d["z"] if zv in (None, "") else float(zv)
    return {"robot": robot,
            "x": float(override.get("x", a.get("x", 0.0))),
            "y": float(override.get("y", a.get("y", 0.0))),
            "z": z}


def resolve_spec(args):
    """Return (scene, [ {robot,x,y,z}, ... ]) from --template | --env/--robot | --scene/--robot."""
    tpl = _opt(args, "--template", None)
    if tpl:
        path = os.path.join(TPL_DIR, tpl if tpl.endswith(".yaml") else tpl + ".yaml")
        if not os.path.exists(path):
            sys.exit(f"[claw] no such template: {tpl} (see `claw templates`)")
        t = _yaml(path)
        env = env_template(t.get("environment"))
        if not env:
            sys.exit(f"[claw] template '{tpl}' references unknown environment '{t.get('environment')}'")
        robots = [_place(r["robot"], env, r.get("anchor"), r) for r in t.get("robots", [])]
        return env["scene"], robots

    env_name = _opt(args, "--env", None)
    robot = _opt(args, "--robot", None)
    if env_name:
        env = env_template(env_name)
        if not env:
            sys.exit(f"[claw] no such environment: {env_name} (see `claw envs-tpl`)")
        robots = []
        if robot:
            robots = [_place(robot, env, _opt(args, "--anchor", None), {"z": _opt(args, "--z", None)})]
        return env["scene"], robots

    # explicit / legacy
    scene = _opt(args, "--scene", "warehouse.usd")
    robots = []
    if robot:
        d = robot_defaults(robot)
        robots = [{"robot": robot,
                   "x": float(_opt(args, "--x", 0)), "y": float(_opt(args, "--y", 0)),
                   "z": float(_opt(args, "--z", d["z"]))}]
    return scene, robots


# --------------------------------------------------------------------------- #
# Commands
# --------------------------------------------------------------------------- #
def _bridge_open(host="127.0.0.1", port=8226):
    """Is a sim already serving the python_server bridge?"""
    try:
        socket.create_connection((host, port), timeout=2).close()
        return True
    except OSError:
        return False


def _kill_stray_sim():
    """Stop any running serve_sim. Safe here — claw runs in the USER's process
    tree (NOT the agent harness, which forbids killing Kit)."""
    subprocess.run(["pkill", "-f", "serve_sim.py"], check=False)
    time.sleep(3)


def cmd_open(args):
    scene, robots = resolve_spec(args)
    if not ensure_server():
        return 1

    gui = "--gui" in args
    st = _req("GET", "/status")[1]
    running = bool(st.get("running") and str(st.get("kind", "")).startswith("sim"))
    # A windowed request always (re)launches; otherwise reuse a running sim.
    if running and not gui:
        print(f"[claw] a sim is already running ({st.get('label')}).")
    else:
        if running or _bridge_open():
            print("[claw] stopping the current/orphaned sim to (re)launch ...")
            _req("POST", "/stop", {})       # stop a tracked job (control server SIGTERMs Kit safely)
            _kill_stray_sim()               # and any untracked orphan holding :8226
        win = "windowed GUI" if gui else "headless"
        print(f"[claw] launching persistent sim ({win}) on '{scene}' (GPU bring-up ~1-2 min) ...")
        _req("POST", "/sim/launch", {"scene": scene, "mode": "serve", "gui": gui})

    # Probe the actual :8226 bridge (a real readiness check, not log-scraping).
    print("[claw] waiting for sim READY ", end="", flush=True)
    ready = False
    for _ in range(150):
        code, resp = _req("POST", "/exec", {"code": "print('pong')"}, timeout=15)
        if code == 200 and resp.get("status") != "error":
            ready = True; break
        print(".", end="", flush=True); time.sleep(2)
    print(" ready" if ready else " (timeout — trying spawn anyway)")

    if not robots:
        print("[claw] sim is up. (no robots in this spec)"); return 0

    rc = 0
    for spec in robots:
        ok = False
        for attempt in range(6):
            code, resp = _req("POST", "/robot/spawn", spec)
            if code == 200 and resp.get("status") != "error":
                print(f"[claw] spawned {spec['robot']} at ({spec['x']},{spec['y']},{spec['z']})")
                ok = True; break
            print(f"[claw] spawn {spec['robot']} attempt {attempt+1} -> {code} "
                  f"{resp.get('error', resp)}; retrying ...")
            time.sleep(5)
        if not ok:
            print(f"[claw] ERROR: could not spawn {spec['robot']} "
                  f"(in catalog? `claw robots`)", file=sys.stderr)
            rc = 1
    return rc


def cmd_templates(_args):
    print("Composite templates (claw open --template <name>):")
    for f in sorted(os.listdir(TPL_DIR)) if os.path.isdir(TPL_DIR) else []:
        if f.endswith(".yaml") and f != "environments.yaml":
            t = _yaml(os.path.join(TPL_DIR, f))
            robots = ", ".join(r.get("robot", "?") for r in t.get("robots", []))
            print(f"  {f[:-5]:20s} env={t.get('environment','?'):12s} robots=[{robots}]")
    print("\nEnvironments (claw open --env <name> --robot <robot>):")
    envs = _yaml(os.path.join(TPL_DIR, "environments.yaml"))
    for name, e in envs.items():
        anchors = ", ".join((e.get("anchors") or {}).keys())
        print(f"  {name:20s} scene={e.get('scene','?'):16s} anchors=[{anchors}]")
    return 0


def cmd_close(_args):
    """Stop the running sim OR training and free the GPU + :8226 bridge."""
    if server_up():
        try:
            r = _req("POST", "/stop", {})[1]
            print(f"[claw] control server: {r.get('status', 'stopped')} "
                  f"{r.get('kind', '')} {r.get('label', '')}".rstrip())
        except Exception as e:
            print(f"[claw] /stop failed: {e}")
    else:
        print("[claw] control server not running.")
    if _bridge_open():                         # catch an orphaned/headless sim
        print("[claw] stopping the sim process (freeing GPU + :8226) ...")
        _kill_stray_sim()
    print("[claw] closed — GPU free." if not _bridge_open()
          else "[claw] a sim is still shutting down; re-run `claw close` if it lingers.")
    return 0


def cmd_train(args):
    if not ensure_server():
        return 1
    task = _opt(args, "--task", None)
    if not task:
        print("usage: claw train --task <id> [--backend rsl_rl|cusrl|skrl]", file=sys.stderr); return 2
    body = {"task": task, "backend": _opt(args, "--backend", "rsl_rl"),
            "num_envs": int(_opt(args, "--num_envs", 4096))}
    print(json.dumps(_req("POST", "/train", body)[1], indent=2)); return 0


def _opt(args, flag, default):
    return args[args.index(flag) + 1] if flag in args else default


def main():
    if len(sys.argv) < 2:
        print(__doc__); return 0
    cmd, rest = sys.argv[1], sys.argv[2:]
    if cmd == "up":
        return 0 if ensure_server() else 1
    if cmd == "open":
        return cmd_open(rest)
    if cmd == "templates":
        return cmd_templates(rest)
    if cmd == "train":
        return cmd_train(rest)
    if cmd in ("status", "envs", "scenes", "robots"):
        if not ensure_server():
            return 1
        path = "/status" if cmd == "status" else "/" + cmd
        print(json.dumps(_req("GET", path)[1], indent=2)); return 0
    if cmd == "envs-tpl":
        return cmd_templates(rest)
    if cmd in ("close", "stop", "shutdown"):
        return cmd_close(rest)
    print(f"unknown command: {cmd}\n{__doc__}", file=sys.stderr); return 2


if __name__ == "__main__":
    sys.exit(main())
